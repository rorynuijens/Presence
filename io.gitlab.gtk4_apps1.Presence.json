        {
            "name": "presence",
            "buildsystem": "simple",
            "build-commands": [
                "rm -rf build src/presence.egg-info",
                "pip3 install --prefix=/app --no-build-isolation --no-deps --no-index .",
                "install -Dm644 data/openssl.cnf /app/etc/openssl.cnf",
                "install -Dm644 src/presence/presence-markdown.xml /app/share/gtksourceview-5/styles/presence-markdown.xml",
                "install -Dm644 src/presence/presence-markdown-light.xml /app/share/gtksourceview-5/styles/presence-markdown-light.xml",
                "install -Dm644 src/presence/presence-markdown-dark.xml /app/share/gtksourceview-5/styles/presence-markdown-dark.xml",
                "install -Dm644 io.gitlab.gtk4_apps1.Presence.svg /app/share/icons/hicolor/scalable/apps/io.gitlab.gtk4_apps1.Presence.svg",
                "install -Dm644 application-x-presence.svg /app/share/icons/hicolor/scalable/mimetypes/application-x-presence.svg",
                "install -Dm644 io.gitlab.gtk4_apps1.Presence.desktop /app/share/applications/io.gitlab.gtk4_apps1.Presence.desktop",
                "install -Dm644 data/io.gitlab.gtk4_apps1.Presence.metainfo.xml /app/share/metainfo/io.gitlab.gtk4_apps1.Presence.metainfo.xml",
                "install -Dm644 data/io.gitlab.gtk4_apps1.Presence.mime.xml /app/share/mime/packages/io.gitlab.gtk4_apps1.Presence.mime.xml",
                "fc-cache -f /app/share/fonts"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        "build",
                        "src/presence.egg-info",
                        ".flatpak-builder",
                        "_build",
                        ".git",
                        ".pytest_cache"
                    ]
                }
            ]
        }
