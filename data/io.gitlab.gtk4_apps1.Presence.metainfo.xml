  </screenshots>

  <launchable type="desktop-id">io.gitlab.gtk4_apps1.Presence.desktop</launchable>

  <url type="homepage">https://gitlab.com/gtk4-apps1/Presence</url>
  <url type="bugtracker">https://gitlab.com/gtk4-apps1/Presence/-/work_items</url>

  <developer id="io.gitlab.gtk4_apps1">
