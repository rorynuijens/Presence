<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.gitlab.gtk4-apps1.Presence</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Presence</name>
  <summary>Convert Markdown to slideshows</summary>

  <description>
    <p>
      Presence is a Markdown-based presentation editor. Write your slides in
      plain Markdown, preview them live, present and export to various formats with a single click.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Live preview as you type</li>
      <li>Multiple built-in themes</li>
      <li>Presenter mode with speaker notes and timer</li>
      <li>Image layout editor</li>
      <li>Export to PDF and HTML</li>
      <li>Drag-and-drop slide reordering</li>
    </ul>
  </description>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <screenshots>
