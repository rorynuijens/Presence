<?xml version="1.0" encoding="UTF-8"?>
<!--
  The dark half of the pair.  Same styles as presence-markdown.xml, read
  against Adwaita's dark view background (#1d1d1d) instead of white, so the
  editor follows the system style rather than pinning one.

  Neither scheme defines "selection" or "cursor": leaving them out lets the
  widget's own CSS paint them, which is how the user's accent colour reaches
  the editor.
-->
<style-scheme id="presence-markdown-dark" name="Presence Markdown Dark" version="1.0">
  <style name="text"                    foreground="#e3e3e3" background="#1d1d1d"/>
  <style name="current-line"            background="#282828"/>
  <style name="line-numbers"            foreground="#5e5c64" background="#242424"/>
  <style name="current-line-number"     foreground="#c0bfbc" background="#2d2d2d"/>
  <style name="bracket-match"           foreground="#ffa348" bold="true"/>
  <style name="bracket-mismatch"        foreground="#ff7b63" bold="true"/>
  <style name="search-match"            background="#e5a50a" foreground="#241f31"/>
  <style name="right-margin"            foreground="#5e5c64"/>
  <style name="markdown:horizontal-rule" foreground="#ffa348" bold="true"/>
  <style name="markdown:thematic-break"  foreground="#ffa348" bold="true"/>
  <style name="markdown:header"          bold="true"/>
  <style name="markdown:atx-header"     bold="true"/>
  <style name="markdown:setext-header"  bold="true"/>
  <style name="markdown:code-span"      foreground="#99c1f1" background="#26313d"/>
  <style name="markdown:code-block"     foreground="#99c1f1" background="#232b34"/>
  <style name="markdown:fenced-code-block" foreground="#99c1f1" background="#232b34"/>
  <style name="markdown:blockquote-marker" italic="true"/>
  <style name="markdown:blockquote"     italic="true"/>
  <style name="markdown:link"           foreground="#78aeed"/>
  <style name="markdown:link-text"      foreground="#78aeed"/>
  <style name="markdown:image"          foreground="#9a9996"/>
  <style name="markdown:url"            foreground="#9a9996"/>
  <style name="markdown:emphasis"       italic="true"/>
  <style name="markdown:strong-emphasis" bold="true"/>
  <style name="def:comment"             foreground="#9a9996" italic="true"/>
</style-scheme>
